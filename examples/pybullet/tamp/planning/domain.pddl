
(define (domain pr2-tamp)
  (:requirements :strips :equality)
  (:constants @sink @stove)
  (:predicates
    (Arm ?a)
    (Graspable ?o)
    (Controllable ?a)
    (Stackable ?o ?r)
    (Sink ?r)
    (Stove ?r)
    (Type ?t ?b)

    (Pose ?o ?p)
    (Grasp ?o ?g)
    (Kin ?a ?o ?p ?g ?q ?t)
    (BaseMotion ?q1 ?t ?q2)
    (ArmMotion ?a ?q1 ?t ?q2)
    (Supported ?o ?p ?r)
    (BTraj ?t)
    (ATraj ?t)

    (InGroup ?o ?g)
    (GroupBefore ?g1 ?g2)
    (Removed ?o)
    (PlacementSlot ?s ?r)
    (SlotNext ?s ?next)
    (NextPlacementSlot ?group ?s)
    (PoseSlot ?o ?p ?s)

    (CFreePosePose ?o ?p ?o2 ?p2)
    (CFreeApproachPose ?o ?p ?g ?o2 ?p2)
    (CFreeTrajPose ?t ?o2 ?p2)
    (CFreeTrajGraspPose ?t ?a ?o1 ?g1 ?o2 ?p2)

    (Connection ?c)
    (ConnectionInvolves ?c ?o)
    (KinDisconnect ?a ?c ?q ?t)
    (Connected ?c)
    (Secured ?o)
    (Extracting ?o)

    (AtPose ?o ?p)
    (AtGrasp ?a ?o ?g)
    (HandEmpty ?a)
    (BConf ?q)
    (AConf ?a ?q)
    (AtBConf ?q)
    (AtAConf ?a ?q)
    (CanMove)
    (Cleaned ?o)
    (Cooked ?o)

    (On ?o ?r)
    (Holding ?a ?o)
    (UnsafePose ?o ?p)
    (UnsafeApproach ?o ?p ?g)
    (UnsafeATraj ?t)
    (UnsafeBTraj ?t)
    (Ontop ?o ?o1)
  )
  (:functions
    (Distance ?q1 ?q2)
    (MoveCost ?t)
    (PickCost)
    (PlaceCost)
    (DisconnectCost)
    (total-cost)
  )

  (:action move_base
    :parameters (?q1 ?q2 ?t)
    :precondition (and (BaseMotion ?q1 ?t ?q2)
                       (AtBConf ?q1) (CanMove))
    :effect (and (AtBConf ?q2)
                 (not (AtBConf ?q1)) (not (CanMove))
                 (increase (total-cost) (Distance ?q1 ?q2)))
  )

  (:action pick
    :parameters (?a ?o ?p ?g ?q ?t)
    :precondition (and (Kin ?a ?o ?p ?g ?q ?t)
                       (AtPose ?o ?p) (HandEmpty ?a) (AtBConf ?q)
                       (not (UnsafeApproach ?o ?p ?g))
                       (not (UnsafeATraj ?t))
                       (not (Secured ?o))
                       (not (Removed ?o))

                       (forall (?o2 ?g2 ?go)
                          (or (not (InGroup ?o ?go))
                              (not (InGroup ?o2 ?g2))
                              (not (GroupBefore ?g2 ?go))
                              (Removed ?o2))))
    :effect (and (AtGrasp ?a ?o ?g) (CanMove)
                 (not (AtPose ?o ?p)) (not (HandEmpty ?a))
                 (not (Extracting ?o))
                 (increase (total-cost) (PickCost)))
  )
  (:action place
    :parameters (?a ?o ?p ?g ?q ?t ?group ?slot ?next)
    :precondition (and (Kin ?a ?o ?p ?g ?q ?t)
                       (InGroup ?o ?group)
                       (NextPlacementSlot ?group ?slot)
                       (SlotNext ?slot ?next)
                       (PoseSlot ?o ?p ?slot)
                       (AtGrasp ?a ?o ?g) (AtBConf ?q)
                       (not (UnsafePose ?o ?p))
                       (not (UnsafeApproach ?o ?p ?g))
                       (not (UnsafeATraj ?t)))
    :effect (and (AtPose ?o ?p) (HandEmpty ?a) (CanMove)
                 (not (AtGrasp ?a ?o ?g))
                 (Removed ?o)
                 (not (NextPlacementSlot ?group ?slot))
                 (NextPlacementSlot ?group ?next)
                 (increase (total-cost) (PlaceCost)))
  )

  (:action disconnect
    :parameters (?a ?c ?o ?q ?t)
    :precondition (and (KinDisconnect ?a ?c ?q ?t)
                       (Connection ?c) (Connected ?c)
                       (ConnectionInvolves ?c ?o)
                       (HandEmpty ?a) (AtBConf ?q)
                       (not (UnsafeATraj ?t))
                       (forall (?o2) (or (= ?o2 ?o) (not (Extracting ?o2)))))
    :effect (and (CanMove) (Extracting ?o)
                 (not (Connected ?c))
                 (increase (total-cost) (DisconnectCost)))
  )

  (:derived (Secured ?o)
    (exists (?c) (and (ConnectionInvolves ?c ?o) (Connected ?c)))
  )

  (:derived (On ?o ?r)
    (exists (?p) (and (Supported ?o ?p ?r)
                      (AtPose ?o ?p)))
  )
  (:derived (Holding ?a ?o)
    (exists (?g) (and (Arm ?a) (Grasp ?o ?g)
                      (AtGrasp ?a ?o ?g)))
  )

  (:derived (UnsafePose ?o ?p)
    (exists (?o2 ?p2) (and (Pose ?o ?p) (Pose ?o2 ?p2) (not (= ?o ?o2))
                           (not (CFreePosePose ?o ?p ?o2 ?p2))
                           (AtPose ?o2 ?p2)))
  )
  (:derived (UnsafeApproach ?o ?p ?g)
    (exists (?o2 ?p2) (and (Pose ?o ?p) (Grasp ?o ?g) (Pose ?o2 ?p2) (not (= ?o ?o2))
                           (not (CFreeApproachPose ?o ?p ?g ?o2 ?p2))
                           (AtPose ?o2 ?p2)))
  )

  (:derived (UnsafeATraj ?t)
    (exists (?o2 ?p2) (and (ATraj ?t) (Pose ?o2 ?p2)
                           (not (CFreeTrajPose ?t ?o2 ?p2))
                           (AtPose ?o2 ?p2)))
  )
)
