  <!-- base_joint fixes base_link to the environment -->
  <joint name="arm_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.25 0 0"/>
    <parent link="top_plate_link"/>
    <child link="arm_base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="arm_base_link-base_link_inertia" type="fixed">
    <parent link="arm_base_link"/>
    <child link="arm_base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="arm_shoulder_pan_joint" type="revolute">
    <parent link="arm_base_link_inertia"/>
    <child link="arm_shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_shoulder_lift_joint" type="revolute">
    <parent link="arm_shoulder_link"/>
    <child link="arm_upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_upper_arm_link"/>
    <child link="arm_forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_wrist_1_joint" type="revolute">
    <parent link="arm_forearm_link"/>
    <child link="arm_wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_wrist_2_joint" type="revolute">
    <parent link="arm_wrist_1_link"/>
    <child link="arm_wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 -2.044881182297852e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_wrist_3_joint" type="revolute">
    <parent link="arm_wrist_2_link"/>
    <child link="arm_wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="arm_ft_frame"/>
  <joint name="arm_wrist_3_link-ft_frame" type="fixed">
    <parent link="arm_wrist_3_link"/>
    <child link="arm_ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="arm_base"/>
  <joint name="arm_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="arm_base_link"/>
    <child link="arm_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="arm_flange"/>
  <joint name="arm_wrist_3-flange" type="fixed">
    <parent link="arm_wrist_3_link"/>
    <child link="arm_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="arm_tool0"/>
  <joint name="arm_flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_flange"/>
    <child link="arm_tool0"/>
  </joint>
  <ros2_control name="robotiq_hande_gripper" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <!-- The right finger joint uses the mimic feature -->
    <joint name="hande_robotiq_hande_left_finger_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">0.025</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.025</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0</param>
      </state_interface>
    </joint>
  </ros2_control>
  <!-- Robotiq Hand-E specs -->
  <!--  + Height added by the IO coupler: 11.0mm -->
  <!--  + Height added by the Hand-E: 99.0mm -->
  <!--  + Coupler mass includes the bolts -->
  <joint name="hande_robotiq_hande_coupler_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="arm_tool0"/>
    <child link="hande_robotiq_hande_coupler"/>
  </joint>
  <link name="hande_robotiq_hande_coupler">
    <visual>
      <geometry>
        <mesh filename="../../../models/robotiq_hande/io_coupler.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.005449999999999999"/>
      <geometry>
        <cylinder length="0.0169" radius="0.0385"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.119"/>
      <origin rpy="0 0 0" xyz="0 0 0.005449999999999999"/>
      <inertia ixx="4.4668218799372e-05" ixy="0.0" ixz="0.0" iyy="4.4668218799372e-05" iyz="0.0" izz="8.367187499999999e-05"/>
    </inertial>
  </link>
  <joint name="hande_robotiq_hande_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.011"/>
    <parent link="hande_robotiq_hande_coupler"/>
    <child link="hande_robotiq_hande_link"/>
  </joint>
  <link name="hande_robotiq_hande_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../../../models/robotiq_hande/hande.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.053450000000000004"/>
      <geometry>
        <cylinder length="0.10690000000000001" radius="0.0385"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.86387"/>
      <origin rpy="0 0 0" xyz="0 0 0.0495"/>
      <inertia ixx="0.0010092697156669523" ixy="0.0" ixz="0.0" iyy="0.0010092697156669523" iyz="0.0" izz="0.00060740859375"/>
    </inertial>
  </link>
  <joint name="hande_robotiq_hande_left_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.099"/>
    <parent link="hande_robotiq_hande_link"/>
    <child link="hande_robotiq_hande_left_finger"/>
    <axis xyz="1 0 0"/>
    <limit effort="130" lower="0.0" upper="0.025" velocity="0.15"/>
  </joint>
  <link name="hande_robotiq_hande_left_finger">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../../../models/robotiq_hande/finger.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../../../models/robotiq_hande/finger_collision.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03804"/>
      <inertia ixx="1E-9" ixy="0.0" ixz="0.0" iyy="1E-9" iyz="0.0" izz="1E-9"/>
    </inertial>
  </link>
  <joint name="hande_robotiq_hande_right_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.099"/>
    <parent link="hande_robotiq_hande_link"/>
    <child link="hande_robotiq_hande_right_finger"/>
    <axis xyz="-1 0 0"/>
    <limit effort="130" lower="0.0" upper="0.025" velocity="0.15"/>
    <mimic joint="hande_robotiq_hande_left_finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="hande_robotiq_hande_right_finger">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../../../models/robotiq_hande/finger.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../../../models/robotiq_hande/finger_collision.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03804"/>
      <inertia ixx="1E-9" ixy="0.0" ixz="0.0" iyy="1E-9" iyz="0.0" izz="1E-9"/>
    </inertial>
  </link>
  <joint name="hande_robotiq_hande_end_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.14550000000000002"/>
    <parent link="hande_robotiq_hande_link"/>
    <child link="hande_robotiq_hande_end"/>
  </joint>
  <link name="hande_robotiq_hande_end"/>
</robot>
